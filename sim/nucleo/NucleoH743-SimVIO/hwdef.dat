# Bench stage B4: NUCLEO-H743ZI2 running ArduPilot with the simulation on the board (no sensors),
# plus external navigation / visual odometry turned back on so EKF3 can fuse vision messages
# (VISION_POSITION_ESTIMATE / ODOMETRY) sent by the KV260.
# Base: ArduPilot NucleoH743 (includes SimOnHW.inc, which disables both features).
# Serial: SERIAL0 = USB OTG (CN13), SERIAL3 = UART7 (PE8 TX, PF6 RX) for the KV260 link.
# Parameters are not stored (HAL_USE_EMPTY_STORAGE in the base board): set them each boot.

include ../NucleoH743/hwdef.dat

undef EK3_FEATURE_EXTERNAL_NAV HAL_VISUALODOM_ENABLED
define EK3_FEATURE_EXTERNAL_NAV 1
define HAL_VISUALODOM_ENABLED 1
