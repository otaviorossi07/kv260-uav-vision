# Compiled-in defaults for NucleoH743-SimVIO (bench B4). This board stores no parameters, so
# settings that only take effect after a reboot must live here.
# simulated GPS; it needs a GPS-protocol port to exist (SERIAL1 = USART3 placeholder)
SERIAL1_PROTOCOL 5
GPS_TYPE 100
# KV260 link on UART7: MAVLink2 at 921600
SERIAL3_PROTOCOL 2
SERIAL3_BAUD 921
# visual odometry backend: MAVLink
VISO_TYPE 1
